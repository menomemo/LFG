## Copy to .env.local and fill in. Never commit .env.local.
## docs/development.md explains where each value comes from.

## ---------------------------------------------------------------------------
## Supabase
## `supabase start` prints the local URL and keys. The anon key is the only one
## a surface (web, mobile) may ever see.
## ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

## Service role key. Bypasses row-level security, so it is confined to
## scheduler plugins, which pass an explicit user context (ADR-0002).
## It must never be exposed to a browser or app bundle — if it ends up in a
## NEXT_PUBLIC_* variable, the tenancy model is gone.
SUPABASE_SERVICE_ROLE_KEY=

## ---------------------------------------------------------------------------
## Model backend
## Business code never names a provider or model (ADR-0003); it reads a tier.
## Development default is a local model, which costs nothing.
## ---------------------------------------------------------------------------
MODEL_BACKEND=local
MODEL_BASE_URL=http://localhost:11434
MODEL_TIER_LIGHT=
MODEL_TIER_HEAVY=

## Per-plugin ceilings. No plugin runs without them (docs/code-standards.md).
PLUGIN_DAILY_CALL_LIMIT=50
PLUGIN_MAX_STEPS=8
