{
  "name": "lfg",
  "version": "0.0.0",
  "private": true,
  "description": "Run a cross-border job search like a managed portfolio",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/menomemo/LFG.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "check": "npm run format && npm run lint && npm run typecheck && npm run test",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
